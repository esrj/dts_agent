    "lptimer3": "LPTIM3",
    "usb3dr": "USB3DR",
    "usbh": "USBH",
    "pcie_rc": "PCIE"
  },
  "system_policy": "AUDIOCLK / DBTRGI / DBTRGO / EVENTOUT / HDP / MCO / SDVSEL / TRACECLK / TRACED 為 system 功能,永不預設啟用,僅使用者明確點名時配置(清單見 all_peripheral.json 的 system 段)",
