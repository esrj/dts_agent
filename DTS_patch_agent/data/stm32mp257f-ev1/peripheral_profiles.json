{
  "soc": "STM32MP257F",
  "description": "Per-family signal profiles for peripheral-level requests. A peripheral token (e.g. SPI3) expands to {FAMILY}{INSTANCE}_{suffix} for the chosen mode. 'default' is the minimal functional set; extra modes are opt-in via TOKEN:mode (e.g. SDMMC2:8bit, USART2:async_flow). The official-DTS signal set takes precedence when a peripheral is already enabled there (see offiicial_dts_peripheral.json).",
  "aliases": { "CAN": "FDCAN", "OCTOSPIM": "OCTOSPI1" },
  "families": {
    "octospi": {
      "default": "quad",
      "template": "OCTOSPIM_P{inst}_{suf}",
      "_note": "OCTOSPI<n> -> manager port P<n> (EV1: OCTOSPI1 -> P1). Names do not follow {FAMILY}{INST}_{suf}, hence the template.",
      "modes": {
        "single": ["CLK", "NCS1", "IO0", "IO1"],
        "quad": ["CLK", "NCS1", "IO0", "IO1", "IO2", "IO3"],
        "octal": ["CLK", "NCS1", "IO0", "IO1", "IO2", "IO3", "IO4", "IO5", "IO6", "IO7"],
        "octal_dqs": ["CLK", "DQS", "NCS1", "IO0", "IO1", "IO2", "IO3", "IO4", "IO5", "IO6", "IO7"]
      }
    },
    "i2c": {
      "default": "std",
      "modes": { "std": ["SCL", "SDA"], "smbus": ["SCL", "SDA", "SMBA"] }
    },
    "i3c": {
      "default": "std",
      "modes": { "std": ["SCL", "SDA"] }
    },
    "spi": {
      "default": "full_duplex",
      "modes": {
        "full_duplex": ["SCK", "MOSI", "MISO"],
        "full_duplex_nss": ["SCK", "MOSI", "MISO", "NSS"],
        "half_duplex": ["SCK", "MOSI"],
        "rx_only": ["SCK", "MISO"]
      }
    },
    "i2s": {
      "default": "std",
      "modes": { "std": ["CK", "WS", "SDI", "SDO"], "with_mck": ["CK", "WS", "SDI", "SDO", "MCK"] }
    },
    "usart": {
      "default": "async",
      "modes": {
        "async": ["TX", "RX"],
        "async_flow": ["TX", "RX", "RTS", "CTS"],
        "sync": ["TX", "RX", "CK"]
      }
    },
    "uart": {
      "default": "async",
      "modes": { "async": ["TX", "RX"], "async_flow": ["TX", "RX", "RTS", "CTS"] }
    },
    "lpuart": {
      "default": "async",
      "modes": { "async": ["TX", "RX"], "async_flow": ["TX", "RX", "RTS", "CTS"] }
    },
    "sdmmc": {
      "default": "4bit",
      "modes": {
        "1bit": ["CK", "CMD", "D0"],
        "4bit": ["CK", "CMD", "D0", "D1", "D2", "D3"],
        "8bit": ["CK", "CMD", "D0", "D1", "D2", "D3", "D4", "D5", "D6", "D7"]
      }
    },
    "fdcan": {
      "default": "std",
      "modes": { "std": ["TX", "RX"] }
    },
    "eth": {
      "default": "rgmii",
      "modes": {
        "rgmii": ["RGMII_TXD0", "RGMII_TXD1", "RGMII_TXD2", "RGMII_TXD3", "RGMII_TX_CTL",
                  "RGMII_CLK125", "RGMII_GTX_CLK", "RGMII_RXD0", "RGMII_RXD1", "RGMII_RXD2",
                  "RGMII_RXD3", "RGMII_RX_CTL", "RGMII_RX_CLK", "MDC", "MDIO"],
        "rmii": ["RMII_TXD0", "RMII_TXD1", "RMII_TX_EN", "RMII_RXD0", "RMII_RXD1",
                 "RMII_CRS_DV", "RMII_REF_CLK", "MDC", "MDIO"]
      }
    }
  }
}
