# Virtual environments
.venv/
venv/
env/

# 使用者系統持久資料（SQLite DB + session secret；不入庫但「不可拋棄」，
# 與 output/ 的覆寫制產物性質不同——備份請帶走整個 var/）
var/

# Byproducts（執行期自動產生，不入庫）
__pycache__/
*.pyc
.DS_Store
.pytest_cache/
node_modules/
output/
plan.inc
.claude
CLAUDE.md
.env

# knowledge_extract 工作區（合併後移入根目錄）
cache/          # PDF 頁快取，可整夾刪除重建
input/          # CLI 待處理材料（手冊/DTS），不入庫
archive/        # 收集品（手冊 PDF/DTS 源碼），大型二進位不入庫

